# Non-secret runtime config for the Tab-hosted box (DB secrets are generated on the box in ~/familye-data/secrets.env)
PORT=8080
HOST=0.0.0.0
PUBLIC_URL=https://familye.sites.tab.bot
COOKIE_SECURE=true
TRUST_PROXY=true
LOG_LEVEL=info
DATABASE_POOL_MAX=5
UPLOAD_MAX_MB=10
FAMILY_TZ=America/New_York
# first admin (created once if missing; the one-time password link's hash is in deploy/admin.env, never committed)
ADMIN_NAME="יואל באכנער"
ADMIN_PHONE="+1 347-985-4847"
ADMIN_EMAIL=yoel@synccos.com
SETUP_TOKEN_DAYS=14
# names used only on the very first boot; afterwards the admin edits them in the app (Admin > family names)
FAMILY_YI="משפחת באכנער-בידערמאן"
FAMILY_EN="Bochner-Biderman Family"
SIDE_A_FAMILY_YI=באכנער
SIDE_A_FAMILY_EN=Bochner
SIDE_B_FAMILY_YI=בידערמאן
SIDE_B_FAMILY_EN=Biderman
