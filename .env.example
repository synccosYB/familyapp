# Copy to .env; fill secrets locally. Never commit your .env.
# Compose uses this password for its private database container.
POSTGRES_PASSWORD=replace-with-random-database-password
APP_ORIGIN=http://localhost:3000
# Use production only behind HTTPS. For localhost, development permits HTTP cookies.
NODE_ENV=development
ADMIN_LOGIN=family-admin
ADMIN_NAME=אדמין
ADMIN_PASSWORD=replace-with-random-admin-password
# For npm run dev without Compose:
DATABASE_URL=postgresql://familye:replace-with-random-database-password@localhost:5432/familye
# Only set to 1 if app is exclusively reachable through one trusted reverse proxy.
TRUST_PROXY_HOPS=0
