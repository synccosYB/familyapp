entrypoint = "src/server.ts"
run = "npm ci --include=dev && npm run build && npm start"

[nix]
channel = "stable-25_05"

[env]
PORT = "3000"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
build = ["sh", "-c", "npm ci --include=dev && npm run build"]
run = ["npm", "start"]
deploymentTarget = "cloudrun"
